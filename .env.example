# Copy to .env (never commit it) or set these in your shell / secret manager.
# Use PAPER trading keys from https://app.alpaca.markets (Paper account -> API keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: a Slack/Discord-compatible incoming webhook URL for warnings and critical alerts.
QUANTBOT_ALERT_WEBHOOK=

# kalshibot (docs/KALSHI.md). Demo keys from https://demo.kalshi.co (Account -> API keys).
# Point at the downloaded private key file; never commit it.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
# Real-money keys are kept separate and are ignored unless the config says environment = "prod".
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=
